# ============================================================
# BloodGuard Backend — Environment Variables Template
# Copy this file to .env and fill in your real credentials.
# NEVER commit .env to version control.
# ============================================================

# --- Server ---
PORT=4000
NODE_ENV=development

# --- MongoDB ---
# Local:  mongodb://localhost:27017/bloodguard
# Atlas:  mongodb+srv://<user>:<pass>@cluster.mongodb.net/bloodguard
MONGO_URI=mongodb://localhost:27017/bloodguard

# --- JWT Authentication ---
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# --- Frontend URL (for CORS and secure SMS links) ---
FRONTEND_URL=http://localhost:4000
BACKEND_BASE_URL=http://localhost:4000

# --- Firebase Admin SDK ---
# Path to your serviceAccountKey.json downloaded from Firebase Console
# Firebase Console → Project Settings → Service Accounts → Generate New Private Key
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# --- Fast2SMS ---
# FAST2SMS_API_KEY from fast2sms.com (Dev API)
FAST2SMS_API_KEY=
FAST2SMS_SENDER_ID=
FAST2SMS_DLT_TEMPLATE_ID_DONOR=
FAST2SMS_DLT_TEMPLATE_ID_PATIENT=
FAST2SMS_DLT_TEMPLATE_ID_ADMIN=
# Admin Indian mobile number as exactly 10 digits, without +91.
ADMIN_PHONE=

# --- Python Isolation Forest ML Microservice ---
# Start with: cd backend/ml && uvicorn fraud_detector:app --port 5001
ML_SERVICE_URL=http://localhost:5001

# --- File Uploads ---
# Max file size in bytes (default: 5MB)
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads
